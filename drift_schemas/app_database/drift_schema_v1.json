  "fixed_sql": [
    {
      "name": "dishes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"dishes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name_en\" TEXT NOT NULL, \"name_ur\" TEXT NOT NULL, \"cuisine\" TEXT NOT NULL DEFAULT 'pakistani', \"dish_type\" TEXT NOT NULL, \"is_veg\" INTEGER NOT NULL CHECK (\"is_veg\" IN (0, 1)), \"protein_type\" TEXT NULL, \"protein_grams_per_person\" INTEGER NULL, \"staple_pairing\" TEXT NOT NULL, \"cooking_style\" TEXT NOT NULL, \"prep_minutes\" INTEGER NOT NULL, \"can_be_side\" INTEGER NOT NULL DEFAULT 0 CHECK (\"can_be_side\" IN (0, 1)), \"is_custom\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_custom\" IN (0, 1)), \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"variant_group\" TEXT NULL, \"notes\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "dish_pairings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"dish_pairings\" (\"main_dish_id\" INTEGER NOT NULL REFERENCES dishes (id) ON DELETE CASCADE, \"side_dish_id\" INTEGER NOT NULL REFERENCES dishes (id) ON DELETE CASCADE, \"priority\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"main_dish_id\", \"side_dish_id\"));"
        }
      ]
    },
    {
      "name": "pantry_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pantry_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"protein_type\" TEXT NOT NULL, \"quantity_grams\" INTEGER NOT NULL, \"added_on\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "dinner_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"dinner_log\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"date\" TEXT NOT NULL UNIQUE, \"day_type\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"main_dish_id\" INTEGER NULL REFERENCES dishes (id), \"side_dish_id\" INTEGER NULL REFERENCES dishes (id), \"outside_note\" TEXT NULL, \"was_suggested\" INTEGER NOT NULL DEFAULT 1 CHECK (\"was_suggested\" IN (0, 1)), \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "pantry_movements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pantry_movements\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"pantry_item_id\" INTEGER NOT NULL REFERENCES pantry_items (id), \"delta_grams\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL, \"dinner_log_id\" INTEGER NULL REFERENCES dinner_log (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
